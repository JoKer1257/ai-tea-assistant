page{font-family:PingFang SC,Noto Sans TC,Helvetica Neue,sans-serif;-webkit-font-smoothing:antialiased;margin:0;padding:0;background-color:#f2efe9}.icon{display:inline-block;font-style:normal;font-variant:normal;text-rendering:auto;line-height:1;text-align:center}.icon-xs{font-size:12px}.icon-sm{font-size:14px}.icon-md{font-size:16px}.icon-lg{font-size:18px}.icon-xl{font-size:20px}.icon-2xl{font-size:24px}.icon-3xl{font-size:32px}.icon-primary{color:#1c1917}.icon-accent{color:#ca8a04}.icon-success{color:#16a34a}.icon-error{color:#dc2626}.icon-warning{color:#d97706}.icon-info{color:#2563eb}.icon-gray{color:#6b7280}.icon-light{color:#f9fafb}.icon-search:before{content:"\1f50d"}.icon-user:before{content:"\1f464"}.icon-heart:before{content:"\2764\fe0f"}.icon-star:before{content:"\2b50"}.icon-share:before{content:"\1f4e4"}.icon-home:before{content:"\1f3e0"}.icon-back:before{content:"\2039"}.icon-menu:before{content:"\2630"}.icon-close:before{content:"\2715"}.icon-check:before{content:"\2713"}.icon-arrow-right:before{content:"\203a"}.icon-tea:before{content:"\1f375"}.icon-leaf:before{content:"\1f343"}.icon-cup:before{content:"\2615"}.icon-flower:before{content:"\1f338"}.icon-mountain:before{content:"\26f0\fe0f"}.icon-water:before{content:"\1f4a7"}.icon-lottery:before{content:"\1f3b0"}.icon-prize:before{content:"\1f3c6"}.icon-ticket:before{content:"\1f3ab"}.icon-gift:before{content:"\1f381"}.icon-robot:before{content:"\1f916"}.icon-chat:before{content:"\1f4ac"}.icon-smart:before{content:"\2728"}body,page{background-color:#f2efe9;background-image:url(https://www.transparenttextures.com/patterns/rice-paper.png);background-blend-mode:soft-light;touch-action:pan-y;-webkit-font-smoothing:antialiased;margin:0;padding:0}.vertical-text{writing-mode:vertical-rl}.text-gradient{background:linear-gradient(180deg,var(--tw-gradient-stops));-webkit-background-clip:text;background-clip:text;color:transparent}.nav-blur{backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px)}.tea-btn-